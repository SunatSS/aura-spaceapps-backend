# Settings for docker compose (copy to .env). All optional; these are the defaults.
AURA_PORT=8080            # host port for http://localhost:8080
AURA_LOG_LEVEL=info
AURA_SEED=auto            # auto: fill an empty DB with the demo mission; off: never seed
AURA_INGEST_TOKEN=        # bearer token for POST /api/v1/ingest; empty + demo seed = aura-demo-ingest
