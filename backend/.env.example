# All variables are optional; these are the defaults.
AURA_HTTP_ADDR=:8080        # if empty, ":$PORT" is used (Render sets PORT)
AURA_DB_PATH=aura.db
AURA_LOG_LEVEL=info
AURA_STATIC_DIR=            # path to the built frontend (e.g. ../aura-spaceapps-frontend/dist); empty = API only
AURA_SEED=auto              # auto: fill an empty DB with the demo mission; off: never seed
